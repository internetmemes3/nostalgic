# Copy this file to .env.local. Next.js reads .env.local.
# Restart `npm run dev` after you change it. One edit updates every screen.

# Solana mint address. Leave blank until it exists. The site shows "soon" while this is empty.
NEXT_PUBLIC_CONTRACT_ADDRESS=

NEXT_PUBLIC_X_URL=https://x.com/nostalgicSolana
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/NostalgicPanel

# Paste the pair URL when the chart is live, for example https://dexscreener.com/solana/yourpair
NEXT_PUBLIC_DEXSCREENER_URL=
